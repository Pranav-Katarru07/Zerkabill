# Photon Spectrum (app.photon.codes -> project Settings)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=

# LLM (xAI Grok by default; set LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY to swap)
LLM_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=
ANTHROPIC_API_KEY=

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs Agents
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# photon = dial through Spectrum SIP trunk (caller ID = our iMessage line); elevenlabs = ElevenLabs' own number
CALL_VIA=photon

# App
PUBLIC_BASE_URL=
DEMO_MODE=true
DEMO_BILLING_OFFICE_NUMBER=
MINIAPP_ENABLED=false
